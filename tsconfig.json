{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@clypra/ui-color-picker": ["../clypra-packages/packages/ui-color-picker/dist/index.d.ts"],
      "@clypra/ui-color-picker/*": ["../clypra-packages/packages/ui-color-picker/dist/*"],
      "@clypra-studio/types": ["../clypra-packages/packages/types/src/index.ts"],
      "@clypra-studio/types/*": ["../clypra-packages/packages/types/src/*"],
      "@clypra-studio/shaders": ["../clypra-packages/packages/shaders/src/index.ts"],
      "@clypra-studio/shaders/*": ["../clypra-packages/packages/shaders/src/*"],
      "@clypra-studio/engine": ["../clypra-packages/packages/clypra-engine/src/index.ts"],
      "@clypra-studio/engine/*": ["../clypra-packages/packages/clypra-engine/src/*"],
      "@gpu-limits": ["./src-tauri/limits/gpu-limits.json"]
    },

    /* Test type declarations */
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
