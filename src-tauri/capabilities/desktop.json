{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-only capabilities for updater and process lifecycle",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "updater:default",
    "process:default",
    "process:allow-exit",
    "process:allow-restart"
  ]
}
